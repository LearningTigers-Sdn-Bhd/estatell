#!/bin/sh
# Enforce Conventional Commits: type(scope): summary
# Example: feat(init): initializes the docs and repo configuration

subject=$(sed -n '/^[^#]/{p;q;}' "$1")

case "$subject" in
    Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

types='feat|fix|refactor|perf|test|docs|style|chore|build|ci|revert'
pattern="^($types)(\([a-z0-9][a-z0-9+./-]*\))?!?: [^ ].*[^.]$"

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
    echo "commit-msg: subject must follow 'type(scope): summary'." >&2
    echo "  types: $(echo "$types" | sed "s/|/, /g")" >&2
    echo "  scope: optional, lowercase (e.g. init, folio, n+1)" >&2
    echo "  summary: no trailing period" >&2
    echo "  got: $subject" >&2
    exit 1
fi

if [ ${#subject} -gt 72 ]; then
    echo "commit-msg: subject is ${#subject} characters; keep it at 72 or fewer." >&2
    exit 1
fi
