includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Laravel types __() as array|string|null. The app only translates string keys that resolve to strings.
        -
            message: '#array(?:<string>)?\|(?:float\|int\|)?string#'
        -
            message: '#non-empty-array\|non-falsy-string#'
