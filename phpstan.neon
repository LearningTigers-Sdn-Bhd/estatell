includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Seeder::$command is documented as non-null, but it is unset when a seeder runs outside db:seed.
        # Laravel's own Seeder checks isset($this->command), so the seeders keep ?->.
        -
            identifier: nullsafe.neverNull
            message: '#^Using nullsafe method call on non-nullable type Illuminate\\Console\\Command\. Use \-\> instead\.$#'
            path: database/seeders/*

        # Laravel types __() as array|string|null. The app only translates string keys that resolve to strings.
        -
            message: '#array(?:<string>)?\|(?:float\|int\|)?string#'
        -
            message: '#non-empty-array\|non-falsy-string#'
