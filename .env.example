APP_NAME=estatell
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# First platform admin, created by `php artisan db:seed`. Leave the password empty to skip.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# BorenoProductionSeeder staff password. Separate from the public demo password.
BORENO_SEED_PASSWORD=

# Demo environment (docs/deployment/demo_environment.md). The demo seeds its staff with DEMO_PASSWORD.
# Production shows DEMO_URL, the Owner logins and DEMO_PASSWORD on the partner Demo access card when DEMO_URL is set.
DEMO_URL=
DEMO_PASSWORD=

# MillionSend API (Resend Alternatives)
MILLIONSEND_BASE_URL=
MILLIONSEND_API_KEY=

# Admins must confirm two-factor before admin actions. Keep true in production.
SUPPORT_REQUIRE_2FA=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Comma list: IPs, CIDRs, *, PRIVATE_SUBNETS, CLOUDFLARE. Production (behind Traefik, no published port): *
TRUSTED_PROXIES=PRIVATE_SUBNETS
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_estatell_dev
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailbox
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (private bucket). Leave empty to keep media on this server.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Channex channel manager. One platform account. Production base URL: https://app.channex.io/api/v1
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
CHANNEX_GROUP_ID=
CHANNEX_WEBHOOK_SECRET=

# Encrypts identity document numbers. Generate with: php artisan ciphersweet:generate-key
# Never change or lose it in production: encrypted data cannot be read without it.
CIPHERSWEET_KEY=

VITE_APP_NAME="${APP_NAME}"
