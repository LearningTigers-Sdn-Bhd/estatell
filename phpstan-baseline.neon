parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#1 \$query of method App\\Services\\Guests\\GuestDirectory\:\:search\(\) expects Illuminate\\Database\\Eloquent\\Builder\<App\\Models\\Guest\>, Illuminate\\Database\\Eloquent\\Builder\<Illuminate\\Database\\Eloquent\\Model\> given\.$#'
			identifier: argument.type
			count: 1
			path: app/Services/Guests/GuestDirectory.php

		-
			message: '#^Method App\\Services\\Reports\\ReportPage\:\:sort\(\) should return array\{list\<TRow of App\\Data\\Reports\\ReportRow&Spatie\\LaravelData\\Data\>, string\} but returns array\{array\<int, App\\Data\\Reports\\ReportRow&Spatie\\LaravelData\\Data\>, string\}\.$#'
			identifier: return.type
			count: 1
			path: app/Services/Reports/ReportPage.php

		-
			message: '#^Access to an undefined property App\\Data\\Reports\\ReportRow\:\:\$key\.$#'
			identifier: property.notFound
			count: 2
