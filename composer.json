{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "brick/math": "^1.0",
        "brick/money": "^0.15",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.50",
        "laravel/pennant": "^1.26",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "league/flysystem-aws-s3-v3": "^3.35",
        "propaganistas/laravel-phone": "^6.0",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-ciphersweet": "^1.9",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-query-builder": "^7.3",
        "spatie/laravel-typescript-transformer": "^3.3",
        "spatie/period": "^2.4",
        "spatie/simple-excel": "^3.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-browser": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "redberry/mailbox-for-laravel": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"preg_match('/^CIPHERSWEET_KEY=\\\\S+/m', file_get_contents('.env')) || passthru('php artisan ciphersweet:generate-key --no-interaction');\"",
            "@php artisan migrate --force",
            "@php artisan typescript:transform",
            "@php artisan db:create-test",
            "npm install",
            "@php artisan boost:update --no-discover --no-interaction --ansi",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run check",
            "npm run types:check",
            "@test"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=2G"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test --parallel --processes=4 --recreate-databases"
        ],
        "docs:screenshots": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test --testsuite=Browser",
            "magick tests/Browser/Screenshots/reservations/reservation-page-summary-source.png -crop 690x768+740+246 +repage -bordercolor '#d4d4d4' -border 1 tests/Browser/Screenshots/reservations/reservation-page-summary.png",
            "magick mogrify -resize 50% tests/Browser/Screenshots/get-started/*.png",
            "mkdir -p \"${DOCS_REPO:-../estatell-docs}/public/screenshots\"",
            "rsync -a --exclude='/*.png' tests/Browser/Screenshots/ \"${DOCS_REPO:-../estatell-docs}/public/screenshots/\""
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
